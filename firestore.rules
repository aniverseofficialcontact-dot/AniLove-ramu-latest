rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user is operating on their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isAuthenticated() ? isOwner(userId) : true;
      
      // User nested collections (library, quiz scores, history)
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() ? isOwner(userId) : true;
      }
    }

    // Unique username claims: public read so anyone can check handle availability
    match /usernames/{username} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.uid == request.auth.uid) || (!isAuthenticated() && request.resource.data.uid is string && request.resource.data.uid.size() > 0);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Public searchable user profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if (isAuthenticated() && request.auth.uid == userId) || (!isAuthenticated() && request.resource.data.userId == userId);
    }

    // Direct Message conversations
    match /chats/{chatId} {
      allow read: if isAuthenticated() ? (request.auth.uid in resource.data.participants) : true;
      allow create: if isAuthenticated() ? (request.auth.uid in request.resource.data.participants) : true;
      allow update: if isAuthenticated() ? (request.auth.uid in resource.data.participants) : true;

      // 5-day expiring chat messages
      match /messages/{messageId} {
        allow read: if true;
        allow create: if (isAuthenticated() ? (request.resource.data.senderId == request.auth.uid) : true)
          && request.resource.data.chatId == chatId;
        allow update: if true;
        allow delete: if true;
      }
    }
  }
}
